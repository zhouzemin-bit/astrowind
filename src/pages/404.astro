---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Page Not Found — Error 404`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-4 font-bold text-9xl text-gray-400 dark:text-gray-600">
          <span class="sr-only">Error</span>404
        </h2>
        <p class="text-2xl font-semibold md:text-3xl text-gray-800 dark:text-gray-200">
          Page not found.
        </p>
        <p class="mt-4 mb-8 text-gray-500 dark:text-gray-400">
          The link you followed may be broken, or the page has been moved or updated.
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn btn-primary">
          Back to Homepage
        </a>
      </div>
    </div>
  </section>
</Layout>
