---
import Layout from '~/layouts/PageLayout.astro';
const metadata = { title: 'Impressum / Legal Notice' };
---
<Layout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-3xl font-bold mb-6">Impressum (Legal Notice)</h1>
    <div class="space-y-4 text-gray-700 dark:text-gray-300">
      <p><strong>Company Name:</strong> Minde Technologies GmbH</p>
      <p><strong>Address:</strong> Mülistrasse 5, 8320 Fehraltorf, Switzerland</p>
      <p><strong>Email:</strong> business@mindetech.ch</p>
      <p><strong>Commercial Register UID:</strong> CHE-XXX.XXX.XXX (请填写真实UID)</p>
      <p><strong>Management:</strong> [负责人姓名]</p>
    </div>
  </section>
</Layout>
