---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Minde Technologies — Innovative Solutions Bridging Europe and China',
};
---

<Layout metadata={metadata}>
  <!-- Hero 模块 -->
  <Hero
    actions={[
      { variant: 'primary', text: 'Get in Touch', href: 'mailto:info@mindetech.ch' },
      { text: 'Learn More', href: '#solutions' },
    ]}
  >
    <Fragment slot="title">
      Innovative Solutions Bridging <span class="text-accent dark:text-white highlight">Europe and China</span>
    </Fragment>
    <Fragment slot="subtitle">
      Empowering enterprises with cutting-edge technology expertise in ICT, intelligent robotics, and cross-border innovation.
    </Fragment>
  </Hero>

  <!-- 核心业务 / 特性 -->
  <Features
    id="solutions"
    title="Our Core Expertise"
    subtitle="Tailored technology consulting and market entry solutions."
    items={[
      {
        title: 'Technology & ICT Solutions',
        description: 'Delivering robust enterprise IT infrastructure, consulting, and seamless technology integration.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Intelligent Robotics & Automation',
        description: 'Representing advanced robotics solutions for industrial and commercial applications in Switzerland and Europe.',
        icon: 'tabler:robot',
      },
      {
        title: 'Cross-Border Technology Bridge',
        description: 'Connecting world-class innovation between Europe and China with localized support and domain expertise.',
        icon: 'tabler:arrows-right-left',
      },
    ]}
  />

  <Features
    id="services"
    title="Our Core Expertise"
    subtitle="Tailored technology consulting and market entry solutions."
    items={[
      {
        title: 'Pre-sales ICT consulting services',
        description: 'Including networking and system plan and design, etc.',
        icon: 'tabler:cpu',
      },
      {
        title: 'OEM and ODM mangement',
        description: 'Bases on our designing and manufacturing resource, we provide OEM and ODM service for limited quantity producing requirements.',
        icon: 'tabler:robot',
      },
      {
        title: 'Post-sales implementation services',
        description: 'Including equipment installation, configuration, and spare parts replacement, etc.',
        icon: 'tabler:arrows-right-left',
      },
    ]}
  />
  <!-- 底部行动呼吁 -->
  <CallToAction
    id="contact"
    title="Ready to Innovate With Us?"
    subtitle="Reach out to discuss partnerships, solutions, and technology collaboration."
    actions={[
      {
        variant: 'primary',
        text: 'Contact Us',
        href: 'mailto:info@mindetech.ch',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>

