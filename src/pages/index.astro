---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';


const metadata = {
  title: 'Minde Technologies — Innovative Solutions Bridging Europe and China',
};
---

<Layout metadata={metadata}>
  <!-- Hero 模块 -->
<!--
<Hero
    actions={[
      { variant: 'primary', text: 'Get in Touch', href: 'mailto:info@mindetech.ch' },
      { text: 'Learn More', href: '#solutions' },
    ]}
  >
    <Fragment slot="title">
      Innovative Solutions Bridging <span class="text-accent dark:text-white highlight">Europe and China</span>
    </Fragment>
    <Fragment slot="subtitle">
      Empowering enterprises with cutting-edge technology expertise in ICT, intelligent robotics, and cross-border innovation.
    </Fragment>
  </Hero>
-->
<Hero
  actions={[
    {
      variant: 'primary',
      text: 'Explore Solutions',
      href: '#solutions',
    },
    {
      text: 'Contact Our Team',
      href: '#contact',
    },
  ]}
>
  <Fragment slot="title">
    Enterprise ICT Solutions Bridging <span class="text-accent dark:text-white highlight">Europe & Asia</span>
  </Fragment>

  <Fragment slot="subtitle">
    Empowering enterprises with robust IT infrastructure, mission-critical systems integration, and seamless cross-border technology consulting from Fehraltorf, Switzerland.
  </Fragment>
</Hero>
  <!-- 核心业务 / 特性 -->
<!-- 
<Features
    id="solutions"
    title="Our Core Expertise"
    subtitle="Tailored technology consulting and market entry solutions."
    items={[
      {
        title: 'Technology & ICT Solutions',
        description: 'Delivering robust enterprise IT infrastructure, consulting, and seamless technology integration.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Intelligent Robotics & Automation',
        description: 'Representing advanced robotics solutions for industrial and commercial applications in Switzerland and Europe.',
        icon: 'tabler:robot',
      },
      {
        title: 'Cross-Border Technology Bridge',
        description: 'Connecting world-class innovation between Europe and China with localized support and domain expertise.',
        icon: 'tabler:arrows-right-left',
      },
    ]}
  />
-->
<Features
  id="solutions"
  tagline="Core Expertise"
  title="Tailored Enterprise ICT & Consulting"
  subtitle="Reliable engineering, end-to-end integration, and localized technology support."
  items={[
    {
      title: 'Enterprise ICT Infrastructure',
      description:
        'Architecting resilient server environments, high-performance networking, and hybrid cloud infrastructures tailored for strict enterprise workloads.',
      icon: 'tabler:server-2',
    },
    {
      title: 'Computuing Virtualization',
      description:
        'Deep expertise in hypervisors and container orchestration platforms ensuring high uptime and stability.',
      icon: 'tabler:cpu',
    },
    {
      title: 'Data Continuity & Disaster Recovery',
      description:
        'Robust data replication, automated backup architectures, and failover disaster recovery solutions designed for regulatory compliance.',
      icon: 'tabler:shield-lock',
    },
    {
      title: '5G Private Network',
      description:
        'Providing comprehensive 5G private network solutions for indoor and outdoor coverage and industry IoT scenarios.',
      icon: 'tabler:network',
    },    
    {
      title: 'OEM and ODM mangement',
      description:
        'Bases on our designing and manufacturing resource, we provide OEM and ODM service for limited quantity producing requirements.',
      icon: 'tabler:arrows-exchange',
    },
    {
      title: 'Swiss On-Premise Support & SLA',
      description:
        'Local engineering presence based in Zurich providing rapid troubleshooting, lifecycle upgrades, and technical consulting.',
      icon: 'tabler:tool',
    },
  ]}
/>
<!--
  <Features
    id="services"
    title="Our Core Services"
    subtitle="Tailored technology consulting and market entry solutions."
    items={[
      {
        title: 'Pre-sales ICT consulting services',
        description: 'Including networking and system plan and design, etc.',
        icon: 'tabler:cpu',
      },
      {
        title: 'OEM and ODM mangement',
        description: 'Bases on our designing and manufacturing resource, we provide OEM and ODM service for limited quantity producing requirements.',
        icon: 'tabler:robot',
      },
      {
        title: 'Post-sales implementation services',
        description: 'Including equipment installation, configuration, and spare parts replacement, etc.',
        icon: 'tabler:arrows-right-left',
      },
    ]}
  />
-->
<Steps
  id="why-us"
  title="Why Partner with Minde Technologies"
  items={[
    {
      title: 'Swiss Engineering Standard & Legal Compliance',
      description:
        'Headquartered in Fehraltorf (Zurich), we adhere to the highest Swiss engineering principles and strict data confidentiality under the Swiss revDSG.',
      icon: 'tabler:award',
    },
    {
      title: 'Dual-Region Domain Knowledge',
      description:
        'We bridge the communication and technical gap between European quality standards and high-velocity Asian ICT ecosystems.',
      icon: 'tabler:world',
    },
    {
      title: 'Full Lifecycle Engineering Engagement',
      description:
        'From architectural consultation and proof of concept (PoC) to deployment, local maintenance, and ongoing SLA support.',
      icon: 'tabler:headset',
    },
  ]}
/>
  <!-- 底部行动呼吁 -->
  <CallToAction
    id="contact"
    title="Ready to Innovate With Us?"
    subtitle="Reach out to discuss partnerships, solutions, and technology collaboration."
    actions={[
      {
        variant: 'primary',
        text: 'Contact Us',
        href: 'mailto:info@mindetech.ch',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>

