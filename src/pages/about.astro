---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About us"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title">
      Innovative Solutions Bridging
      <span class="text-accent dark:text-white"> Europe and China</span>
    </Fragment>

    <Fragment slot="subtitle">
      Founded in 2023 in Switzerland, Minde Technologies GmbH is dedicated to building a bridge between Europe and China in the fields of ICT and renewable energy. 
      Our founder and employees have extensive experience in the ICT and renewable energy sectors, and they have deep-rooted knowledge of the European market and Chinese suppliers. 
      This expertise allows us to deliver top-quality solutions and services to our Swiss and European clients. 
      We are committed to fostering collaboration and innovation in these key industries, facilitating growth and sustainability on a global scale to bring the latest digital technologies to you.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Statistics about us"
    stats={[
      { title: 'Years', amount: '3+' },
      { title: 'ICT Experts', amount: '10+' },
      { title: 'Projects', amount: '30+' },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Our Locations"
    tagline="Find us"
    columns={1}
    items={[
      {
        title: 'Switzerland',
        description: 'Mülistrasse 5, 8320 Fehraltorf, Switzerland',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Technical Support"
    tagline="Contact us"
    columns={1}
    items={[
      {
        title: 'Email us',
        description:
          'support@mindetech.ch',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
